KNOWLEDGEOPS_APP_ENV=local
KNOWLEDGEOPS_MODEL_PROVIDER=fake
KNOWLEDGEOPS_MODEL_ID=fake-calculator-v1
KNOWLEDGEOPS_MODEL_INPUT_LIMIT=4096
KNOWLEDGEOPS_MODEL_OUTPUT_LIMIT=512
KNOWLEDGEOPS_MODEL_TIMEOUT_SECONDS=30
KNOWLEDGEOPS_MAX_DOCUMENT_BYTES=1048576
# Reserved for a real model adapter in Day 10; never commit a real key.
KNOWLEDGEOPS_MODEL_API_KEY=

# One PostgreSQL database for documents, ACLs, chunks, conversations, vectors and Agent.
KNOWLEDGEOPS_DATABASE_URL=postgresql://knowledgeops:local-day5-only@127.0.0.1:55432/knowledgeops
KNOWLEDGEOPS_INGESTION_WORKER_ENABLED=true
KNOWLEDGEOPS_INGESTION_LEASE_SECONDS=30
KNOWLEDGEOPS_INGESTION_MAX_ATTEMPTS=3
KNOWLEDGEOPS_INGESTION_POLL_SECONDS=0.2

# pgvector uses KNOWLEDGEOPS_DATABASE_URL; no second database URL is needed.
KNOWLEDGEOPS_EMBEDDING_PROVIDER=fake
KNOWLEDGEOPS_EMBEDDING_MODEL_ID=fake-hash-v1
KNOWLEDGEOPS_EMBEDDING_DIMENSIONS=128
KNOWLEDGEOPS_EMBEDDING_COLLECTION=day5-fake
KNOWLEDGEOPS_EMBEDDING_BATCH_SIZE=16
KNOWLEDGEOPS_EMBEDDING_CONCURRENCY=2
KNOWLEDGEOPS_EMBEDDING_TIMEOUT_SECONDS=30
KNOWLEDGEOPS_EMBEDDING_MAX_ATTEMPTS=3
# Compatible adapter uses POST BASE_URL/embeddings. Use a NEW collection.
KNOWLEDGEOPS_EMBEDDING_BASE_URL=https://api.example.invalid/v1
KNOWLEDGEOPS_EMBEDDING_API_KEY=
# Set from your provider's actual pricing; blank means cost unknown.
KNOWLEDGEOPS_EMBEDDING_COST_PER_MILLION_TOKENS=

# Day 7 generation is separate from the Day 2/10 Agent model configuration.
KNOWLEDGEOPS_GENERATION_PROVIDER=fake
KNOWLEDGEOPS_GENERATION_MODEL_ID=fake-extractive-v1
KNOWLEDGEOPS_GENERATION_INPUT_LIMIT=16384
KNOWLEDGEOPS_GENERATION_OUTPUT_LIMIT=2048
# History/summary budgets are UTF-8 bytes; input tokens use a conservative byte estimate.
KNOWLEDGEOPS_GENERATION_HISTORY_BUDGET=2048
KNOWLEDGEOPS_GENERATION_SUMMARY_BUDGET=2048
KNOWLEDGEOPS_GENERATION_TIMEOUT_SECONDS=30
# compatible uses BASE_URL/chat/completions + JSON mode, with local schema validation.
KNOWLEDGEOPS_GENERATION_BASE_URL=https://api.example.invalid/v1
KNOWLEDGEOPS_GENERATION_API_KEY=

# Day 9 selected profile: hybrid; rerank disabled after real dev comparison. See docs/day9.md.
KNOWLEDGEOPS_RETRIEVAL_STRATEGY=hybrid
KNOWLEDGEOPS_RETRIEVAL_CANDIDATE_K=20
KNOWLEDGEOPS_RETRIEVAL_RRF_CONSTANT=60
# none = disabled; fake = lexical test double; compatible = Qwen /reranks adapter.
KNOWLEDGEOPS_RERANK_PROVIDER=none
KNOWLEDGEOPS_RERANK_MODEL_ID=qwen3-rerank
# Full endpoint; choose the provider's actual workspace and region.
KNOWLEDGEOPS_RERANK_ENDPOINT=https://api.example.invalid/v1/reranks
KNOWLEDGEOPS_RERANK_API_KEY=
KNOWLEDGEOPS_RERANK_TIMEOUT_SECONDS=10
KNOWLEDGEOPS_RERANK_COST_PER_MILLION_TOKENS=

# Agent state uses KNOWLEDGEOPS_DATABASE_URL. Business queries use the SAME database
# with a SELECT-only role; run scripts/setup_agent_demo.py to provision the local role.
KNOWLEDGEOPS_AGENT_BUSINESS_DATABASE_URL=postgresql://knowledgeops_agent_reader:local-agent-read-only@127.0.0.1:55432/knowledgeops
KNOWLEDGEOPS_AGENT_PROVIDER=fake
KNOWLEDGEOPS_AGENT_MODEL_ID=fake-agent-v1
KNOWLEDGEOPS_AGENT_BASE_URL=https://api.example.invalid/v1
KNOWLEDGEOPS_AGENT_API_KEY=
KNOWLEDGEOPS_AGENT_MAX_STEPS=8
KNOWLEDGEOPS_AGENT_MAX_SECONDS=60
KNOWLEDGEOPS_AGENT_MAX_TOKENS=120000
KNOWLEDGEOPS_AGENT_CONTEXT_LIMIT=32000
KNOWLEDGEOPS_AGENT_OUTPUT_LIMIT=1024
# Prices per million tokens, SAME currency as MAX_COST; required for compatible provider.
KNOWLEDGEOPS_AGENT_INPUT_PRICE=
KNOWLEDGEOPS_AGENT_OUTPUT_PRICE=
KNOWLEDGEOPS_AGENT_MAX_COST=0.1
KNOWLEDGEOPS_AGENT_CONCURRENCY=4
KNOWLEDGEOPS_AGENT_REQUESTS_PER_MINUTE=20
KNOWLEDGEOPS_AGENT_APPROVAL_SECONDS=900
